# ============ Core ============
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Lumen
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ============ Supabase (Phase 1) ============
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ============ Cloudflare R2 media (Phase 3) ============
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ============ Security (Phase 2) ============
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============ Email (Phase 8) ============
RESEND_API_KEY=
EMAIL_FROM="Lumen <orders@yourdomain.com>"
# Resend free plan allows 100 emails per day
EMAIL_DAILY_LIMIT=100

# ============ AI chatbot (Phase 13) ============
# AI chatbot: a free OpenRouter key (openrouter.ai/keys). Can also be set in Admin > Chatbot.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional. Change if Google renames models.
GEMINI_MODEL=gemini-2.5-flash

# Staff must use 2FA (authenticator app). Set to false ONLY for first local setup.
STAFF_REQUIRE_2FA=true

# ============ Cron protection ============
CRON_SECRET=

# Payment, courier, AliExpress, GA4, GTM and Pixel credentials are entered in
# Admin > Settings and stored encrypted in the database, not here.
